    "# Combined aggregation figure\n",
    "\n",
    "\n",
    "# Panel order\n",
    "panel_order = [\"DiPietro et al. 2023\", \"Shaffer et al. 2024\", \"French et al. 2023\", \"Fischer et al. 2002\", \"Mathias et al. 1995\", \"Boixereu et al. 2002\",]\n",
